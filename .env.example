# ---- LLM provider -------------------------------------------------------
# One of: ollama | gemini | openai
LLM_PROVIDER=ollama

# Primary model and an optional fallback used when the primary is
# overloaded / rate-limited (HTTP 429 / 503).
#   ollama : LLM_MODEL=qwen2.5:7b          (run: ollama pull qwen2.5:7b)
#   gemini : LLM_MODEL=gemini-flash-latest  LLM_FALLBACK_MODEL=gemini-flash-lite-latest
#   openai : LLM_MODEL=gpt-4o-mini
LLM_MODEL=qwen2.5:7b
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0.2

# ---- Credentials (set only the one for your provider) -------------------
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
# For Ollama: run `ollama serve` and `ollama pull qwen2.5:7b`
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- Workflow -----------------------------------------------------------
DATA_DIR=data
OUTPUT_DIR=output
# Documents processed concurrently. Use 1 for Ollama (it serves one request at a
# time by default); 2-4 for Gemini/OpenAI depending on your rate limits.
MAX_WORKERS=1
# Retry attempts per LLM call for transient errors
LLM_MAX_RETRIES=4
# Verify each customer email against the source document and revise once if it
# contains unsupported claims (adds 1-3 LLM calls per document)
EMAIL_GROUNDING_CHECK=true
LOG_LEVEL=INFO
